[Unit]
Description=Express Starter App
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/express-starter/app
EnvironmentFile=/opt/express-starter/app/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
# Allow binding to low ports (<1024) without running as root.
# Remove this line if nginx fronts the app and PORT is >=1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
